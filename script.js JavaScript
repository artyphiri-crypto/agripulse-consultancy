  document.getElementById("serviceSelect").value = "Agribusiness Management";
  document.getElementById("clientBrief").value =
    `Enterprise review for ${crop} (${area} ha): Projected Revenue ${revenue}, Total Cost ${totalCost}, Net Gross Margin ${margin}, Break-Even Yield ${breakEven}. Looking for advisory on optimising margins and market timing.`;

  document.getElementById("consult").scrollIntoView({ behavior: "smooth" });
}


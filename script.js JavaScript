// Render Hero Snapshot
function renderHeroSnapshot() {
  heroSnapshot.innerHTML = commodityData.slice(0, 3).map(item => {
    const badgeColor = item.trend === "up"
      ? "text-green-700 bg-green-100"
      : item.trend === "down"
      ? "text-red-700 bg-red-100"
      : "text-slate-700 bg-slate-100";

    return `
      <div class="flex items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-100">
        <div>
          <p class="font-semibold text-sm text-slate-900">${item.name}</p>
          <p class="text-xs text-slate-500">30d Target: <span class="font-medium text-slate-700">${item.forecast}</span></p>
        </div>
        <div class="text-right">
          <p class="font-bold text-sm text-slate-900">${item.price}</p>
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded ${badgeColor}">${item.change}</span>
        </div>
      </div>
    `;
  }).join("");
}

// Render Market Table
function renderMarketTable(data) {
  if (data.length === 0) {
    marketTableBody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-slate-500">No matching commodities found.</td></tr>`;
    return;
  }

  marketTableBody.innerHTML = data.map(item => {
    const trendBadge = item.trend === "up"
      ? `<span class="inline-flex items-center gap-1 text-green-700 bg-green-100 px-2.5 py-0.5 rounded-full text-xs font-semibold"><i class="fa-solid fa-arrow-trend-up"></i> ${item.change}</span>`
      : item.trend === "down"
      ? `<span class="inline-flex items-center gap-1 text-red-700 bg-red-100 px-2.5 py-0.5 rounded-full text-xs font-semibold"><i class="fa-solid fa-arrow-trend-down"></i> ${item.change}</span>`
      : `<span class="inline-flex items-center gap-1 text-slate-700 bg-slate-100 px-2.5 py-0.5 rounded-full text-xs font-semibold"><i class="fa-solid fa-minus"></i> ${item.change}</span>`;

    return `
      <tr class="hover:bg-slate-50">
        <td class="py-4 px-4 font-semibold text-slate-900">${item.name}</td>
        <td class="py-4 px-4 text-slate-600">${item.category}</td>
        <td class="py-4 px-4 font-bold text-slate-900">${item.price}</td>
        <td class="py-4 px-4">${trendBadge}</td>
        <td class="py-4 px-4 font-semibold text-agriGreen">${item.forecast}</td>
        <td class="py-4 px-4 text-slate-600 max-w-xs">${item.outlook}</td>
      </tr>
    `;
  }).join("");
}

// Filter Commodities
function filterMarketData() {
  const query = cropSearch.value.toLowerCase();
  const category = categoryFilter.value;

  const filtered = commodityData.filter(item => {
    const matchesSearch = item.name.toLowerCase().includes(query) || item.outlook.toLowerCase().includes(query);
    const matchesCategory = category === "All" || item.category === category;
    return matchesSearch && matchesCategory;
  });

  renderMarketTable(filtered);
}

cropSearch.addEventListener("input", filterMarketData);
categoryFilter.addEventListener("change", filterMarketData);

// Gross Margin & Break-Even Calculator
const formatMWK = (num) => "MWK " + Math.round(num).toLocaleString("en-GB");

function calculateMargin() {
  const area = Math.max(0, parseFloat(document.getElementById("calcArea").value) || 0);
  const yieldPerHa = Math.max(0, parseFloat(document.getElementById("calcYield").value) || 0);
  const costPerHa = Math.max(0, parseFloat(document.getElementById("calcCostPerHa").value) || 0);
  const pricePerKg = Math.max(0, parseFloat(document.getElementById("calcPricePerKg").value) || 0);
  const logistics = Math.max(0, parseFloat(document.getElementById("calcLogistics").value) || 0);

  const totalKg = area * yieldPerHa;
  const revenue = totalKg * pricePerKg;
  const totalCost = (area * costPerHa) + logistics;
  const margin = revenue - totalCost;
  const marginRatio = revenue > 0 ? ((margin / revenue) * 100).toFixed(1) : "0.0";
  const breakEvenKg = pricePerKg > 0 ? Math.ceil(totalCost / pricePerKg) : 0;

  document.getElementById("outTotalKg").textContent = `${Math.round(totalKg).toLocaleString("en-GB")} kg`;
  document.getElementById("outRevenue").textContent = formatMWK(revenue);
  document.getElementById("outTotalCost").textContent = formatMWK(totalCost);
  document.getElementById("outBreakEven").textContent = `${breakEvenKg.toLocaleString("en-GB")} kg`;

  const marginEl = document.getElementById("outMargin");
  marginEl.textContent = formatMWK(margin);
  marginEl.className = margin >= 0
    ? "text-2xl font-extrabold text-agriGreen"
    : "text-2xl font-extrabold text-red-600";

  document.getElementById("outMarginRate").textContent = `Gross Margin Ratio: ${marginRatio}%`;
}

document.querySelectorAll(".calc-input").forEach(input => {
  input.addEventListener("input", calculateMargin);
});

function loadPreset(key) {
  const p = presets[key];
  if (!p) return;
  document.getElementById("calcCrop").value = p.crop;
  document.getElementById("calcArea").value = p.area;
  document.getElementById("calcYield").value = p.yieldPerHa;
  document.getElementById("calcCostPerHa").value = p.costPerHa;
  document.getElementById("calcPricePerKg").value = p.pricePerKg;
  document.getElementById("calcLogistics").value = p.logistics;
  calculateMargin();
}

